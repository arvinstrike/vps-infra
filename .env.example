# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Public base domain for Caddy-served subdomains (e.g. status.<DOMAIN>).
# Caddy idles until this is set and its DNS points at the droplet.
DOMAIN=example.com

# Email for Let's Encrypt / ACME registration.
ACME_EMAIL=admin@example.com

# Shared Postgres 16 (internal network only). Generate a strong password:
# openssl rand -hex 32
POSTGRES_USER=vpsadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# Qdrant (internal network only). Generate a strong key:
# openssl rand -hex 32
QDRANT_API_KEY=changeme

# TEI (text-embeddings-inference, internal only). No secret needed.
# Consumers reach it at http://tei — e.g. bmn-regulatory-rag sets EMBEDDINGS_URL=http://tei
TEI_MODEL=BAAI/bge-m3

# Langfuse (self-hosted v2, internal + served via Caddy at langfuse.<DOMAIN>).
# Uses the shared Postgres (database `langfuse`). Generate each secret:
#   NEXTAUTH_SECRET, SALT: openssl rand -base64 32   |   ENCRYPTION_KEY: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme
LANGFUSE_ENCRYPTION_KEY=changeme
